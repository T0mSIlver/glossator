ion\">\n\nList all voices (excluding sample data)\n\n</OperationDescriptionSection>\n\n<OperationCodeSamplesSection slot=\"code-samples\">\n\n<CodeSampleTabbedSection>\n\n<CodeSampleTab\n  slot=\"tab\"\n  id=\"operation-list_voices_v1_audio_voices_get_code-samples_typescript\"\n  tags={{\"codeSample\":\"typescript\"}}\n>\n\nTypeScript\n\n</CodeSampleTab>\n\n<SectionContent\n  slot=\"content\"\n  id=\"operation-list_voices_v1_audio_voices_get_code-samples_typescript\"\n>\n\n<CodeSample>\n\n```typescript\nimport { Mistral } from \"@mistralai/mistralai\";\n\nconst mistral = new Mistral({\n  apiKey: \"MISTRAL_API_KEY\",\n});\n\nasync function run() {\n  const result = await mistral.audio.voices.list({});\n\n  console.log(result);\n}\n\nrun();\n\n```\n\n</CodeSample>\n\n</SectionContent>\n\n<CodeSampleTab\n  slot=\"tab\"\n  id=\"operation-list_voices_v1_audio_voices_get_code-samples_python\"\n  tags={{\"codeSample\":\"python\"}}\n>\n\nPython\n\n</CodeSampleTab>\n\n<SectionContent\n  slot=\"content\"\n  id=\"operation-list_voices_v1_audio_voices_get_code-samples_python\"\n>\n\n<SDKVersionCodeSample>\n<div data-version=\"v2\">\n<CodeSample>\n\n```python\nfrom mistralai.client import Mistral\nimport os\n\n\nwith Mistral(\n    api_key=os.getenv(\"MISTRAL_API_KEY\", \"\"),\n) as mistral:\n\n    res = mistral.audio.voices.list(limit=10, offset=0, type_=\"all\")\n\n    # Handle response\n    print(res)\n\n\n```\n\n</CodeSample>\n</div>\n\n</SDKVersionCodeSample>\n\n</SectionContent>\n\n<CodeSampleTab\n  slot=\"tab\"\n  id=\"operation-list_voices_v1_audio_voices_get_code-samples_curl\"\n  tags={{\"codeSample\":\"curl\"}}\n>\n\ncURL\n\n</CodeSampleTab>\n\n<SectionContent slot=\"content\" id=\"operation-list_voices_v1_audio_voices_get_code-samples_curl\">\n\n<CodeSample>\n\n```curl\ncurl https://api.mistral.ai/v1/audio/voices \\\n -X GET \\\n -H 'Authorization: Bearer YOUR_APIKEY_HERE'\n```\n\n</CodeSample>\n\n</SectionContent>\n\n</CodeSampleTabbedSection>\n\n</OperationCodeSampl