# Local settings for glossator. Copy to .env and fill in the key:
#
#   cp .env.example .env
#
# The Makefile exports every line of .env to the commands it runs, and the API and
# MCP servers also load it themselves. Everything but the key is optional and shown
# commented out at its default: uncomment a line to change it, and do not leave a
# setting blank, since the code reads a blank value as set. A server deployment has
# its own file, deploy/.env.deploy.example.

# --- Required -------------------------------------------------------------

# Embeddings always go to the Mistral API; so do generation and reranking unless
# GLOSSATOR_CHAT_SERVER_URL is set.
MISTRAL_API_KEY=

# --- Index ----------------------------------------------------------------

# Host ports of the local Vespa container (docker-compose.yaml).
# VESPA_QUERY_PORT=18080
# VESPA_CONFIG_PORT=19072
# Name and hostname of the local Vespa container. A second checkout on the same
# machine sets its own here, next to its own two ports.
# VESPA_CONTAINER=glossator-vespa
# Query endpoint, when Vespa runs elsewhere. Default http://localhost:$VESPA_QUERY_PORT.
# VESPA_ENDPOINT=http://localhost:18080
# Config server `make migrate-vespa` deploys to. Default http://localhost:$VESPA_CONFIG_PORT.
# VESPA_CONFIG_URL=http://localhost:19072
# Embedding cache `make ingest` reads and writes, and `make deploy` copies to the
# host so re-ingestion there skips the API. An absolute path; unset uses
# $HOME/.cache/glossator/embeddings. Point it at an empty directory to measure a
# first-run embedding cost.
# GLOSSATOR_EMBEDDING_CACHE=
# Corpus the API and MCP servers read pages from.
# GLOSSATOR_CORPUS_DIR=corpus/mistral-docs
# Root under which `make bruno` writes vespa/bruno/vespa/.
# WORKSPACE_ROOT=.

# --- Models ---------------------------------------------------------------

# Listwise reranker behind `make ask` and POST /ask: Mistral Small 4. A key without
# Small quota sets ministral-14b-2512.
# GLOSSATOR_RERANK_MODEL=mistral-small-2603
# Generation model for POST /ask when the request names none. Unset or blank uses
# the shipped default, Mistral Medium 3.5.
# GLOSSATOR_MODEL=
# Mistral-compatible endpoint for embeddings.
# MISTRAL_API_URL=https://api.mistral.ai
# Local OpenAI-compatible server for chat completions (generation, reranking,
# rewrites). Unset sends chat to the Mistral API.
# GLOSSATOR_CHAT_SERVER_URL=http://127.0.0.1:8081
# Key for that server. Unset falls back to MISTRAL_API_KEY.
# GLOSSATOR_CHAT_API_KEY=
# reasoning_effort sent on every chat call; `none` turns thinking off. Unset sends nothing.
# GLOSSATOR_CHAT_REASONING_EFFORT=none
# Sampling overrides as key=value pairs (temperature, top_p, min_tokens). Unset keeps
# the pipeline's own settings.
# GLOSSATOR_CHAT_SAMPLING=temperature=1,min_tokens=4096
# Model the snapshot evaluation generates with. Unset uses the local server's Ministral
# when GLOSSATOR_CHAT_SERVER_URL is set, and the shipped model otherwise.
# GLOSSATOR_CHAT_MODEL=
# Z.ai endpoint and key for dataset generation and the GLM judge (evaluation only).
# ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
# ZAI_API_KEY=

# --- MCP ------------------------------------------------------------------

# Index variant the MCP server searches: page128, sec128 or sec1024.
# GLOSSATOR_VARIANT=sec1024
# Bearer token required on the HTTP transport. Unset means no authentication.
# GLOSSATOR_MCP_TOKEN=
# Comma-separated subset of mistral_docs_search, mistral_docs_read_page and
# mistral_docs_history. Unset registers all three.
# GLOSSATOR_MCP_TOOLS=mistral_docs_search,mistral_docs_read_page

# --- Snapshots ------------------------------------------------------------

# Manifest of the dated snapshots the history forms read.
# GLOSSATOR_SNAPSHOT_MANIFEST=eval/snapshots/manifest.json
