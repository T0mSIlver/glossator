# Settings for a glossator deployment. Copy to deploy/.env.deploy, fill it in,
# and keep it out of version control: it holds two secrets.
#
#   cp deploy/.env.deploy.example deploy/.env.deploy
#
# deploy.sh copies this file to the target host next to deploy/compose.yaml.

# --- Required -------------------------------------------------------------

# Embeddings always go to the Mistral API, and so does generation unless
# GLOSSATOR_CHAT_SERVER_URL is set.
MISTRAL_API_KEY=

# The shared secret for the MCP HTTP transport. Every request except
# `GET /health` must carry `Authorization: Bearer <this>`. Mistral Work detects
# bearer authentication from the server URL and asks for the token.
#   openssl rand -hex 32
GLOSSATOR_MCP_TOKEN=

# --- Index ----------------------------------------------------------------

# remote-index mode: a Vespa serving the shipped schemas on another host.
#   VESPA_ENDPOINT=http://192.168.1.98:18080
# full mode: leave this unset and the MCP server reaches the `vespa` service
# over the compose network.
VESPA_ENDPOINT=

# Which index variant this deployment serves: page128, sec128 or sec1024.
GLOSSATOR_VARIANT=sec1024

# --- Tunnel ---------------------------------------------------------------

# The Cloudflare tunnel hostname, once it exists. Only used to print the real
# Connector URL and curl commands at the end of a deploy.
GLOSSATOR_PUBLIC_HOSTNAME=

# --- Tools ----------------------------------------------------------------

# Comma-separated subset of mistral_docs_search, mistral_docs_read_page,
# mistral_docs_history. Blank registers all three.
GLOSSATOR_MCP_TOOLS=

# Generation model for the API's POST /ask. Blank uses the shipped default.
GLOSSATOR_MODEL=

# Optional local chat server for generation (embeddings still go to the API).
# Reachable from inside the container, so not 127.0.0.1.
GLOSSATOR_CHAT_SERVER_URL=
GLOSSATOR_CHAT_API_KEY=

# --- Ports and binding ----------------------------------------------------

# The tunnel runs on the deployment host and reaches the server over the
# loopback address. Widen MCP_BIND_ADDRESS to 0.0.0.0 only for a LAN test.
MCP_BIND_ADDRESS=127.0.0.1
MCP_PORT=8000

# Only used when the `api` profile is enabled (deploy.sh --with-api).
API_BIND_ADDRESS=127.0.0.1
API_PORT=8080

# Only used in full mode. VESPA_CONFIG_URL is where the migration job reaches
# the config server from inside the compose network, not from this machine.
VESPA_BIND_ADDRESS=127.0.0.1
VESPA_QUERY_PORT=18080
VESPA_CONFIG_PORT=19072
VESPA_CONFIG_URL=http://vespa:19071
VESPA_MEMORY_LIMIT=4G
VESPA_MEMORY_RESERVATION=2G

# --- Images ---------------------------------------------------------------

GLOSSATOR_IMAGE_TAG=local
VESPA_IMAGE_TAG=latest
